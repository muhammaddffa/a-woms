// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LoadType {
  FCL
  LCL
}

enum ChargeAppliesTo {
  FCL
  LCL
  ALL
}

enum Direction {
  EXPORT
  IMPORT
}

enum WorkOrderStatus {
  OPEN
  COST_CHECKED
  COST_APPROVED
  CLOSED
  CANCELLED
}

enum WorkOrderItemStatus {
  DRAFT
  ACTIVE
  CANCELLED
}

// Cara jenis biaya ditagihkan ke customer.
//   FIXED   = tarif tetap dari billable_charges (mis. trucking per ritase, harga kesepakatan pabrik)
//   AT_COST = ditagih sebesar realisasi LPJ yang disetujui (mis. THC, lift on/off, BBM, tol)
enum BillingMode {
  FIXED
  AT_COST
}

// Siapa yang menanggung suatu komponen biaya. Disalin ke planned_costs saat rencana biaya
// dibuat, sehingga perubahan kesepakatan vendor tidak mengubah trip yang sudah berjalan.
//   COMPANY          = ditanggung perusahaan, masuk biaya efektif WO
//   VENDOR           = ditanggung vendor, tidak ada dana perusahaan yang keluar (tidak boleh di-cashbon)
//   DEDUCT_FROM_VENDOR = ditalangi perusahaan lalu dipotong dari pembayaran vendor (bukan biaya WO)
enum CostBearer {
  COMPANY
  VENDOR
  DEDUCT_FROM_VENDOR
}

enum CashAdvanceType {
  OPERATIONAL // cashbon biaya operasional / pengurusan
  DRIVER_ALLOWANCE // uang jalan
}

// Alur penuh:
//   DRAFT -> CHECKED -> APPROVED -> PAID -> TRANSFER_VERIFIED -> REPORT_SUBMITTED
//         -> REPORT_CHECKED -> REPORT_APPROVED -> SETTLED
// Langkah CHECKED, TRANSFER_VERIFIED, dan REPORT_CHECKED dapat dilewati bila dinonaktifkan
// di workflow_settings (daftar langkah yang berlaku disalin ke cash_advances.required_steps).
// PAID = Keuangan sudah mentransfer dana + bukti transfer.
// TRANSFER_VERIFIED = Checker memastikan transfer; LPJ hanya boleh dimulai dari status ini
// (atau dari PAID bila langkah verifikasi transfer dinonaktifkan).
enum CashAdvanceStatus {
  DRAFT
  CHECKED
  APPROVED
  PAID
  TRANSFER_VERIFIED
  REPORT_SUBMITTED
  REPORT_CHECKED
  REPORT_APPROVED
  SETTLED
  REJECTED
  CANCELLED
}

enum AdvanceReturnStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

// Arah penyelesaian selisih dana dan realisasi LPJ.
//   RETURN_TO_COMPANY = ada sisa; staf operasional mengembalikan ke perusahaan
//   REIMBURSE_STAFF   = ada kekurangan; perusahaan mengganti ke staf operasional
enum AdvanceReturnDirection {
  RETURN_TO_COMPANY
  REIMBURSE_STAFF
}

enum ApprovalDocType {
  WORK_ORDER_COST
  CASH_ADVANCE
  ADVANCE_RETURN
}

enum ApprovalStep {
  CHECK
  APPROVE
  PAY
  VERIFY_TRANSFER
  REPORT_SUBMIT
  REPORT_CHECK
  REPORT_APPROVE
  RECEIVE
}

enum ApprovalAction {
  DONE
  REJECT
  REVERT
}

enum AttachmentOwnerType {
  CASH_ADVANCE
  CASH_ADVANCE_ITEM
  CASH_ADVANCE_EXTRA_COST
  ADVANCE_RETURN
  WORK_ORDER_ITEM
}

enum AttachmentKind {
  RECEIPT
  PHOTO
  PDF
  TRANSFER_PROOF
}

enum AccountingEventStatus {
  PENDING
  POSTED
  FAILED
}

// ---------------------------------------------------------------------
// 1. AKSES (RBAC dinamis)
//    Permission dibuat developer (dicek di kode); admin mengatur role,
//    isi permission tiap role, dan role tiap user lewat UI.
// ---------------------------------------------------------------------
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  username     String   @unique
  email        String?  @unique
  fullName     String   @map("full_name")
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles UserRole[]

  createdWorkOrders       WorkOrder[]          @relation("WorkOrderCreatedBy")
  createdPlannedCosts     PlannedCost[]        @relation("PlannedCostCreatedBy")
  createdCashAdvances     CashAdvance[]        @relation("CashAdvanceCreatedBy")
  heldCashAdvances        CashAdvance[]        @relation("CashAdvanceHolder")
  createdAdvanceReturns   AdvanceReturn[]      @relation("AdvanceReturnCreatedBy")
  approvalActions         ApprovalHistory[]
  uploadedAttachments     Attachment[]
  updatedWorkflowSettings WorkflowSetting[]    @relation("WorkflowSettingUpdatedBy")
  workflowSettingLogs     WorkflowSettingLog[] @relation("WorkflowSettingLogChangedBy")
  containerPositionLogs   ContainerPositionLog[]
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique // mis. DIRECTOR, COMMISSIONER
  name        String // nama tampilan: "Direktur"
  description String?
  isSystem    Boolean  @default(false) @map("is_system") // role bawaan, tidak boleh dihapus
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  code        String @unique // format resource:action, mis. cash_advance:approve
  module      String // untuk pengelompokan di UI
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------
// 2. DATA MASTER
// ---------------------------------------------------------------------
model Customer {
  id               String  @id @default(uuid(7)) @db.Uuid
  code             String  @unique
  name             String
  invoiceName      String? @map("invoice_name")
  paymentTermsDays Int     @default(0) @map("payment_terms_days")
  entityCode       String  @default("AGS") @map("entity_code")
  isActive         Boolean @default(true) @map("is_active")

  workOrders WorkOrder[]

  @@map("customers")
}

// Jenis biaya/tarif. Mengendalikan perilaku costing dan penagihan.
//   useActualCost = true  -> biaya efektif memakai realisasi LPJ (bukan biaya rencana)
//   billingMode           -> nilai tagihan: FIXED dari billable_charges, AT_COST dari realisasi LPJ
model ChargeType {
  id             String          @id @default(uuid(7)) @db.Uuid
  code           String          @unique
  name           String
  category       String? // TRUCKING, LOLO, HANDLING, ADD PEB, CONTAINER, UANG_JALAN, dst
  appliesTo      ChargeAppliesTo @default(ALL) @map("applies_to")
  useActualCost  Boolean         @default(false) @map("use_actual_cost")
  billingMode    BillingMode     @default(FIXED) @map("billing_mode")
  isTrucking     Boolean         @default(false) @map("is_trucking")
  isHidden       Boolean         @default(false) @map("is_hidden") // tarif sembunyi, butuh izin khusus
  sortOrder      Int             @default(0) @map("sort_order")
  defaultCost    Decimal         @default(0) @map("default_cost") @db.Decimal(18, 2)
  defaultPrice   Decimal         @default(0) @map("default_price") @db.Decimal(18, 2)
  revenueAccount String?         @map("revenue_account")
  costAccount    String?         @map("cost_account")
  isActive       Boolean         @default(true) @map("is_active")

  plannedCosts    PlannedCost[]
  billableCharges BillableCharge[]
  extraCosts      CashAdvanceExtraCost[]

  @@map("charge_types")
}

model Vehicle {
  id         String  @id @default(uuid(7)) @db.Uuid
  plateNo    String  @unique @map("plate_no")
  ownerCode  String? @map("owner_code")
  isInternal Boolean @default(false) @map("is_internal")

  workOrderItems WorkOrderItem[]

  @@map("vehicles")
}

model Driver {
  id    String @id @default(uuid(7)) @db.Uuid
  code  String @unique
  name  String
  phone String?

  workOrderItems WorkOrderItem[]

  @@map("drivers")
}

model CashAccount {
  id   String @id @default(uuid(7)) @db.Uuid
  code String @unique
  name String

  cashAdvances   CashAdvance[]
  advanceReturns AdvanceReturn[]

  @@map("cash_accounts")
}

// ---------------------------------------------------------------------
// 3. WORK ORDER
// ---------------------------------------------------------------------
model WorkOrder {
  id          String          @id @default(uuid(7)) @db.Uuid
  number      String          @unique
  orderDate   DateTime        @map("order_date") @db.Date
  customerId  String          @map("customer_id") @db.Uuid
  brand       String?
  project     String?
  entityCode  String          @default("AGS") @map("entity_code")
  isDummy     Boolean         @default(false) @map("is_dummy")
  status      WorkOrderStatus @default(OPEN)
  costNote    String?         @map("cost_note")
  createdById String?         @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User?    @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])

  items        WorkOrderItem[]
  cashAdvances CashAdvance[]

  @@index([orderDate, customerId])
  @@map("work_orders")
}

// Satu baris = satu trip / kontainer / truk dalam WO
model WorkOrderItem {
  id                  String              @id @default(uuid(7)) @db.Uuid
  workOrderId         String              @map("work_order_id") @db.Uuid
  lineNo              Int                 @map("line_no")
  direction           Direction?
  referenceNo         String?             @map("reference_no")
  loadType            LoadType            @default(FCL) @map("load_type")
  containerSize       String?             @map("container_size")
  containerNo         String?             @map("container_no")
  sealNo              String?             @map("seal_no")
  vehicleId           String?             @map("vehicle_id") @db.Uuid
  driverId            String?             @map("driver_id") @db.Uuid
  origin              String?
  destination         String?
  status              WorkOrderItemStatus @default(DRAFT)
  tare                Decimal?            @db.Decimal(10, 2) // kilogram
  actualContainerSize String?             @map("actual_container_size")
  stuffingLocation    String?             @map("stuffing_location")
  currentPositionId   String?             @map("current_position_id") @db.Uuid
  positionNote        String?             @map("position_note")
  positionUpdatedAt   DateTime?           @map("position_updated_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id])
  driver    Driver?   @relation(fields: [driverId], references: [id])

  currentPosition     ContainerPosition?     @relation(fields: [currentPositionId], references: [id])
  positionLogs        ContainerPositionLog[]

  plannedCosts        PlannedCost[]
  billableCharges     BillableCharge[]
  extraCosts          CashAdvanceExtraCost[]

  @@index([currentPositionId])
  @@unique([workOrderId, lineNo])
  @@index([containerNo])
  @@index([vehicleId])
  @@map("work_order_items")
}

// ---------------------------------------------------------------------
// 4. BIAYA RENCANA & TARIF TAGIH
//    totalCost / totalPrice diisi service layer = round(quantity * unit, 2)
// ---------------------------------------------------------------------
model PlannedCost {
  id              String     @id @default(uuid(7)) @db.Uuid
  workOrderItemId String     @map("work_order_item_id") @db.Uuid
  chargeTypeId    String     @map("charge_type_id") @db.Uuid
  quantity        Decimal    @default(1) @db.Decimal(18, 4)
  unitCost        Decimal    @default(0) @map("unit_cost") @db.Decimal(18, 2)
  totalCost       Decimal    @default(0) @map("total_cost") @db.Decimal(18, 2)
  note            String?
  bearer          CostBearer @default(COMPANY) // penanggung komponen biaya ini (lihat enum CostBearer)
  bearerNote      String?    @map("bearer_note") // alasan bila berbeda dari kesepakatan standar vendor
  createdById     String?    @map("created_by") @db.Uuid
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  workOrderItem WorkOrderItem @relation(fields: [workOrderItemId], references: [id])
  chargeType    ChargeType    @relation(fields: [chargeTypeId], references: [id])
  createdBy     User?         @relation("PlannedCostCreatedBy", fields: [createdById], references: [id])

  advanceItems CashAdvanceItem[]

  @@unique([workOrderItemId, chargeTypeId])
  @@map("planned_costs")
}

// Tarif yang akan ditagih ke customer. invoiceId null = belum ditagih.
// Untuk jenis biaya AT_COST, baris ini dibuat/diperbarui otomatis saat LPJ disetujui.
model BillableCharge {
  id              String  @id @default(uuid(7)) @db.Uuid
  workOrderItemId String  @map("work_order_item_id") @db.Uuid
  chargeTypeId    String  @map("charge_type_id") @db.Uuid
  quantity        Decimal @default(1) @db.Decimal(18, 4)
  unitPrice       Decimal @default(0) @map("unit_price") @db.Decimal(18, 2)
  totalPrice      Decimal @default(0) @map("total_price") @db.Decimal(18, 2)
  invoiceId       String? @map("invoice_id") @db.Uuid // relasi ke Invoice ditambahkan di modul invoice
  note            String?

  workOrderItem WorkOrderItem @relation(fields: [workOrderItemId], references: [id])
  chargeType    ChargeType    @relation(fields: [chargeTypeId], references: [id])

  @@unique([workOrderItemId, chargeTypeId])
  @@map("billable_charges")
}

// ---------------------------------------------------------------------
// 5. PENGAJUAN DANA (uang jalan & cashbon biaya operasional)
// ---------------------------------------------------------------------
model CashAdvance {
  id            String            @id @default(uuid(7)) @db.Uuid
  number        String            @unique
  advanceType   CashAdvanceType   @default(OPERATIONAL) @map("advance_type")
  workOrderId   String            @map("work_order_id") @db.Uuid
  advanceDate   DateTime          @map("advance_date") @db.Date
  recipient     String // penerima dana
  holderId      String?           @map("holder_user_id") @db.Uuid // staf operasional pemegang dana, wajib membuat LPJ
  cashAccountId String?           @map("cash_account_id") @db.Uuid
  transferFee   Decimal           @default(0) @map("transfer_fee") @db.Decimal(18, 2)
  description   String?
  status        CashAdvanceStatus @default(DRAFT)
  // Langkah pengecekan yang berlaku untuk dokumen ini (CHECK, VERIFY_TRANSFER, REPORT_CHECK).
  // Dihitung dari workflow_settings dan total pengajuan selama DRAFT, lalu dibekukan
  // saat dokumen meninggalkan DRAFT agar perubahan pengaturan tidak memengaruhi dokumen berjalan.
  requiredSteps ApprovalStep[]    @default([]) @map("required_steps")
  createdById   String?           @map("created_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  workOrder   WorkOrder           @relation(fields: [workOrderId], references: [id])
  holder      User?               @relation("CashAdvanceHolder", fields: [holderId], references: [id])
  createdBy   User?               @relation("CashAdvanceCreatedBy", fields: [createdById], references: [id])
  cashAccount CashAccount?        @relation(fields: [cashAccountId], references: [id])

  items       CashAdvanceItem[]
  extraCosts  CashAdvanceExtraCost[]
  returnItems AdvanceReturnItem[]
  

  @@index([workOrderId])
  @@index([status, advanceDate])
  @@map("cash_advances")
}

model CashAdvanceItem {
  id            String   @id @default(uuid(7)) @db.Uuid
  cashAdvanceId String   @map("cash_advance_id") @db.Uuid
  plannedCostId String   @map("planned_cost_id") @db.Uuid
  advanceAmount Decimal  @map("advance_amount") @db.Decimal(18, 2) // dana yang diberikan
  actualAmount  Decimal? @map("actual_amount") @db.Decimal(18, 2) // realisasi LPJ; null = belum dilaporkan
  note          String?

  cashAdvance CashAdvance @relation(fields: [cashAdvanceId], references: [id], onDelete: Cascade)
  plannedCost PlannedCost @relation(fields: [plannedCostId], references: [id])

  @@unique([cashAdvanceId, plannedCostId])
  @@index([plannedCostId])
  @@map("cash_advance_items")
}

// Biaya di luar rencana yang dilaporkan saat LPJ (dulu: "tambahan" uang jalan).
// chargeTypeId memetakan biaya ke jenis biaya agar ikut ditagihkan (bila AT_COST dan billable).
model CashAdvanceExtraCost {
  id              String  @id @default(uuid(7)) @db.Uuid
  cashAdvanceId   String  @map("cash_advance_id") @db.Uuid
  workOrderItemId String  @map("work_order_item_id") @db.Uuid
  chargeTypeId    String  @map("charge_type_id") @db.Uuid
  description     String
  amount          Decimal @db.Decimal(18, 2)
  billable        Boolean @default(true) // false = ditanggung perusahaan, tidak ditagihkan ke customer
  note            String?

  cashAdvance   CashAdvance   @relation(fields: [cashAdvanceId], references: [id], onDelete: Cascade)
  workOrderItem WorkOrderItem @relation(fields: [workOrderItemId], references: [id])
  chargeType    ChargeType    @relation(fields: [chargeTypeId], references: [id])

  @@index([cashAdvanceId])
  @@index([chargeTypeId])
  @@map("cash_advance_extra_costs")
}

// ---------------------------------------------------------------------
// 6. PENGEMBALIAN SISA DANA / PENGGANTIAN KEKURANGAN
//    Satu dokumen untuk dua arah (lihat enum AdvanceReturnDirection), keduanya
//    wajib bukti transfer (attachments, kind TRANSFER_PROOF).
// ---------------------------------------------------------------------
model AdvanceReturn {
  id            String                 @id @default(uuid(7)) @db.Uuid
  number        String                 @unique
  direction     AdvanceReturnDirection @default(RETURN_TO_COMPANY)
  returnDate    DateTime               @map("return_date") @db.Date
  returnedBy    String                 @map("returned_by") // nama pihak yang menyerahkan dana (atau penerima, untuk penggantian)
  cashAccountId String?                @map("cash_account_id") @db.Uuid
  status        AdvanceReturnStatus    @default(DRAFT)
  note          String?
  createdById   String?                @map("created_by") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id])
  createdBy   User?        @relation("AdvanceReturnCreatedBy", fields: [createdById], references: [id])

  items AdvanceReturnItem[]

  @@map("advance_returns")
}

model AdvanceReturnItem {
  id              String  @id @default(uuid(7)) @db.Uuid
  advanceReturnId String  @map("advance_return_id") @db.Uuid
  cashAdvanceId   String  @map("cash_advance_id") @db.Uuid
  amount          Decimal @db.Decimal(18, 2)

  advanceReturn AdvanceReturn @relation(fields: [advanceReturnId], references: [id], onDelete: Cascade)
  cashAdvance   CashAdvance   @relation(fields: [cashAdvanceId], references: [id])

  @@unique([advanceReturnId, cashAdvanceId])
  @@map("advance_return_items")
}

// ---------------------------------------------------------------------
// 7. JEJAK, LAMPIRAN, ANTREAN JURNAL
//    docId / ownerId sengaja tanpa foreign key (menunjuk ke beberapa tabel,
//    dibedakan oleh docType / ownerType).
// ---------------------------------------------------------------------
model ApprovalHistory {
  id      String          @id @default(uuid(7)) @db.Uuid
  docType ApprovalDocType @map("doc_type")
  docId   String          @map("doc_id") @db.Uuid
  step    ApprovalStep
  action  ApprovalAction
  actorId String          @map("actor_id") @db.Uuid
  actedAt DateTime        @default(now()) @map("acted_at") @db.Timestamptz(6)
  note    String?

  actor User @relation(fields: [actorId], references: [id])

  @@index([docType, docId, actedAt])
  @@map("approval_history")
}

model Attachment {
  id           String              @id @default(uuid(7)) @db.Uuid
  ownerType    AttachmentOwnerType @map("owner_type")
  ownerId      String              @map("owner_id") @db.Uuid
  kind         AttachmentKind
  storageKey   String              @map("storage_key") // path di object storage, bukan BLOB
  fileName     String?             @map("file_name")
  mimeType     String?             @map("mime_type")
  sizeBytes    Int?                @map("size_bytes")
  uploadedById String?             @map("uploaded_by") @db.Uuid
  uploadedAt   DateTime            @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([ownerType, ownerId])
  @@map("attachments")
}

// Antrean posting jurnal (diisi di modul akuntansi)
model AccountingEvent {
  id         String                @id @default(uuid(7)) @db.Uuid
  eventType  String                @map("event_type") // ADVANCE_PAID, REPORT_APPROVED, RETURN_RECEIVED
  sourceType String                @map("source_type")
  sourceId   String                @map("source_id") @db.Uuid
  status     AccountingEventStatus @default(PENDING)
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt   DateTime?             @map("posted_at") @db.Timestamptz(6)

  @@map("accounting_events")
}

// ---------------------------------------------------------------------
// 8. PENGATURAN ALUR PERSETUJUAN
//    Hanya langkah pengecekan yang bisa diatur (CHECK, VERIFY_TRANSFER, REPORT_CHECK).
//    Langkah inti (APPROVE, PAY, REPORT_SUBMIT, REPORT_APPROVE) tetap di kode dan
//    tidak bisa dinonaktifkan. minAmount: langkah hanya berlaku bila total pengajuan >= minAmount.
// ---------------------------------------------------------------------
model WorkflowSetting {
  id          String          @id @default(uuid(7)) @db.Uuid
  docType     ApprovalDocType @map("doc_type")
  step        ApprovalStep
  isEnabled   Boolean         @default(true) @map("is_enabled")
  minAmount   Decimal         @default(0) @map("min_amount") @db.Decimal(18, 2)
  updatedById String?         @map("updated_by") @db.Uuid
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User?                @relation("WorkflowSettingUpdatedBy", fields: [updatedById], references: [id])
  logs      WorkflowSettingLog[]

  @@unique([docType, step])
  @@map("workflow_settings")
}

// Jejak perubahan pengaturan: siapa, kapan, nilai lama dan baru.
model WorkflowSettingLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  settingId   String   @map("setting_id") @db.Uuid
  oldValue    Json     @map("old_value")
  newValue    Json     @map("new_value")
  changedById String   @map("changed_by") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  setting   WorkflowSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  changedBy User            @relation("WorkflowSettingLogChangedBy", fields: [changedById], references: [id])

  @@index([settingId, changedAt])
  @@map("workflow_setting_logs")
}
model ContainerPosition {
  id        String  @id @default(uuid(7)) @db.Uuid
  code      String  @unique
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  items WorkOrderItem[]
  logs  ContainerPositionLog[]

  @@map("container_positions")
}

model ContainerPositionLog {
  id              String   @id @default(uuid(7)) @db.Uuid
  workOrderItemId String   @map("work_order_item_id") @db.Uuid
  positionId      String   @map("position_id") @db.Uuid
  note            String?
  actorId         String   @map("actor_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrderItem WorkOrderItem     @relation(fields: [workOrderItemId], references: [id], onDelete: Cascade)
  position      ContainerPosition @relation(fields: [positionId], references: [id])
  actor         User              @relation(fields: [actorId], references: [id])

  @@index([workOrderItemId, createdAt])
  @@map("container_position_logs")
}